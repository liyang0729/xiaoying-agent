# 复制本文件为 .env 并填入你的真实配置（.env 不要提交到 git）
# 任何 OpenAI 兼容接口均可，例如 DeepSeek / 通义千问 / 智谱 等

# API 密钥（必填）
LLM_API_KEY=your-api-key-here

# API 基础地址（必填）。DeepSeek 示例：https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com

# 模型名称（必填）。DeepSeek 示例：deepseek-chat
LLM_MODEL=deepseek-chat

# Agent 最大执行步数（可选，默认 8）
MAX_STEPS=8
